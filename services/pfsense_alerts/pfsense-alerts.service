[Unit]
Description=pfsense-alerts: webservice pfSense posts alerts to (services/pfsense_alerts/server.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joe
WorkingDirectory=/home/joe/thecodes
ExecStart=/usr/bin/python3 -u services/pfsense_alerts/server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
